{
    "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.24/MicrosoftTeams.schema.json",
    "manifestVersion": "1.24",
    "version": "1.0.0",
    "id": "e5ccb243-6964-4d8e-a47e-d343a33d10fc",
    "developer": {
        "name": "TESTA MOTARI Automotive GmbH",
        "websiteUrl": "https://www.example.com",
        "privacyUrl": "https://www.example.com/privacy",
        "termsOfUseUrl": "https://www.example.com/termofuse"
    },
    "icons": {
        "color": "color.png",
        "outline": "outline.png"
    },
    "name": {
        "short": "Maro-Bot",
        "full": "Maro-Bot Message Logger"
    },
    "description": {
        "short": "Saves messages to SharePoint",
        "full": "A Teams bot that logs messages to daily files in SharePoint"
    },
    "accentColor": "#FFFFFF",
    "bots": [
        {
            "botId": "e5ccb243-6964-4d8e-a47e-d343a33d10fc",
            "scopes": [
                "personal",
                "team",
                "groupChat"
            ],
            "supportsFiles": false,
            "isNotificationOnly": false,
            "commandLists": [
                {
                    "scopes": ["personal", "team", "groupChat"],
                    "commands": [
                        {
                            "title": "Hi",
                            "description": "Say hi to the bot."
                        }
                    ]
                }
            ]
        }
    ],
    "composeExtensions": [],
    "configurableTabs": [],
    "staticTabs": [],
    "permissions": [
        "identity",
        "messageTeamMembers"
    ],
    "validDomains": []
}
